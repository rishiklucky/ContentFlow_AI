# ==========================================
# ContentFlow AI - Root Environment Config
# ==========================================

# Core Application Settings
PROJECT_NAME="ContentFlow AI"
ENVIRONMENT=production
DEBUG=False
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Neon PostgreSQL Database URL
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key & Model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Direct Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Signing Key & Session Settings
SECRET_KEY=generate_a_secure_random_32_byte_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
