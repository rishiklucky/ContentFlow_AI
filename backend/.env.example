# ==========================================
# ContentFlow AI Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="ContentFlow AI"
ENVIRONMENT=production
DEBUG=False
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS Configuration (Allows custom origins if needed; same-origin in single-service deployment)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Neon PostgreSQL Database URL (Obtain from Neon Console)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key (Obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# JWT Security & Encryption Key (Generate via: openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_32_byte_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
