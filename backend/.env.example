# ==========================================
# ContentFlow AI Backend Environment Config
# ==========================================

# Application Settings
PROJECT_NAME="ContentFlow AI"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Placeholder (Neon PostgreSQL for Phase 2+)
DATABASE_URL=postgresql+psycopg2://user:password@host.neon.tech/dbname?sslmode=require

# Google Gemini API Placeholder (For Phase 3+)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Security & Tokens Placeholder (For Phase 2+)
SECRET_KEY=generate_a_secure_random_secret_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
